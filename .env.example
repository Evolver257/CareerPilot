DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot@localhost:5432/careerpilot
REDIS_URL=redis://localhost:6379/0
POSTGRES_DB=careerpilot
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=careerpilot
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_STRUCTURED_MAX_TOKENS=8192
LLM_STRUCTURED_RETRY_MAX_TOKENS=12288
# Replace this with a long random secret before using a non-development deployment.
LLM_ENCRYPTION_KEY=replace-with-a-long-random-secret
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# The default deployment uses the local multilingual Qwen3 Embedding model. For
# OpenAI-compatible embeddings use text-embedding-3-small together with
# EMBEDDING_PROVIDER=openai and a key.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
# Independent durable ranking / knowledge-index worker (PostgreSQL required).
INDEPENDENT_WORKER=true
# Install .[semantic], switch EMBEDDING_PROVIDER=sentence_transformers, then backfill.
SEMANTIC_MODEL=Qwen/Qwen3-Embedding-0.6B
SEMANTIC_CACHE_DIR=
# local (fast rules) or cross_encoder (higher CPU latency)
RAG_RERANKER=local
SEMANTIC_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_EVIDENCE_MIN_RELEVANCE=0.42
RAG_RRF_K=60
RAG_SPARSE_WEIGHT=0.55
RAG_DENSE_WEIGHT=0.45
# Native OpenAI/Anthropic tools are preferred; failures are explicitly traced before fallback.
CAREER_ADVISOR_NATIVE_TOOLS_ENABLED=true
AGENT_TOOL_TIMEOUT_SECONDS=30
# Comma-separated executable basenames permitted for local Stdio MCP. Empty denies all.
MCP_STDIO_ALLOWED_COMMANDS=
MCP_DISCOVERY_TTL_SECONDS=3600
JOB_POSSIBLY_EXPIRED_DAYS=14
JOB_EXPIRED_DAYS=30
RAG_MIN_QUALITY_SCORE=0.35
MAX_UPLOAD_SIZE_BYTES=10485760
DEFAULT_USER_EMAIL=demo@careerpilot.local
DEFAULT_USER_NAME=Demo User
MATCHING_SEMANTIC_WEIGHT=0.25
MATCHING_SKILL_WEIGHT=0.25
MATCHING_EDUCATION_WEIGHT=0.15
MATCHING_EXPERIENCE_WEIGHT=0.10
MATCHING_LOCATION_WEIGHT=0.10
MATCHING_PREFERENCE_WEIGHT=0.10
MATCHING_LLM_WEIGHT=0.05
MATCHING_RETRIEVAL_TOP_K=8
MATCHING_RERANK_TOP_K=4
MATCHING_SCORE_VERSION=MATCHING_V1
RANKING_CANDIDATE_LIMIT=300
TOP_K_EMBEDDING=100
TOP_K_RERANK=10
TOP_K_LLM=10
FINAL_RANKING_TOP_K=10
RANKING_VERSION=RANKING_V1
OBSERVABILITY_ENABLED=false
API_PORT=8010
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
